[Unit]
Description=DHT Sensor Prometheus Exporter
After=network.target
Documentation=https://github.com/chapvic/dht-exporter

[Service]
Type=exec
ExecStart=/usr/local/bin/dht-exporter
Restart=on-failure
RestartSec=5

User=dht-exporter
Group=dht-exporter

# Capability for modprobe
AmbientCapabilities=CAP_SYS_MODULE

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/dht-exporter /proc/sensors/dht
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
